# --- per-install, never share -------------------------------------------
# Anchors and taught glyphs are bitmaps captured at YOUR ui scale and layout.
# They are meaningless on another machine and must be regenerated locally.
anchor_*.png
values/
config.json
config.json.*
*.bak
CLIENTS
MODE
PAUSED

# --- your gameplay data, not the tool ------------------------------------
# events.* contain signature ids, pilot names and system names. Keep them out
# of a shared repo.
events.log
events.csv
snapshots/

# --- environment ----------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.npy

# office lock files - they embed your hostname and username
.~lock.*#
~$*
config.json.tmp
config.json.prev
CLIPBOARD_OWNER
PAUSED.*
pilots.json
pilots.json.tmp
pilot_marks.log
signatures.json
signatures.json.tmp
